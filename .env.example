# "mock" = lee de los Excel locales en Tablas/ (nada de Google Cloud, ideal para probar la UI).
# "google" = lee/escribe de una Google Sheet real (necesita el resto de las variables de abajo).
DATA_SOURCE=mock

# Carpeta donde están los Excel en modo mock, relativa a la carpeta pautador/.
# Si seguiste la estructura tal cual (pautador/ al lado de Tablas/), no hace falta tocar esto.
MOCK_DATA_DIR=../Tablas

# Puerto local (Toni usa 3000 para su piloto — lo dejamos igual)
PORT=3000

# --- Solo para DATA_SOURCE=google ---
# ID de la Google Sheet que funciona como bus de datos.
# Se saca de la URL: https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEET_ID=

# Ruta al JSON de la cuenta de servicio de Google Cloud (ver README).
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# Alternativa a la ruta de arriba para Railway (no tiene el archivo en disco):
# pegar acá el CONTENIDO ENTERO del JSON de la Service Account, en una sola
# línea. Si está seteada, esta gana sobre GOOGLE_SERVICE_ACCOUNT_KEY_PATH.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# --- Meta Graph API ---
# "mock" (default) = "Confirmar" solo simula, genera IDs MOCK- y no toca Meta.
# "real" = llama de verdad a la Graph API (crea todo en PAUSED, nunca activa nada).
META_MODE=mock

# Identidad de la App de Meta (developers.facebook.com → tu App → Configuración básica).
# Sirven para intercambiar/extender tokens, pero NO alcanzan solos para leer
# cuentas de un Business Manager — para eso hace falta META_ACCESS_TOKEN.
META_APP_ID=
META_APP_SECRET=
META_CLIENT_TOKEN=

# ID del Business Manager donde viven las cuentas publicitarias/páginas de prueba.
META_BUSINESS_ID=

# Token del System User de Meta (Business Manager) — el que de verdad autoriza
# a leer/escribir cuentas publicitarias y páginas. Se genera en Configuración
# del negocio → Usuarios del sistema → (tu system user) → Generar nuevo token.
# NUNCA subir esto a git — .env ya está en .gitignore, pero doble chequeo si
# vas a compartir pantalla.
META_ACCESS_TOKEN=

# Versión de la Graph API (la misma que ya usan los activos reales en config_activos).
META_GRAPH_API_VERSION=v24.0

# Estado inicial en Meta de los pedidos AUTOMATIZADOS hechos desde la pantalla:
# PAUSED (default) o ACTIVE (lanzamiento 2026-09-16 — gasto real inmediato).
# La ingesta de las hojas salida_manual_* usa INGESTA_ESTADO_INICIAL.
AUTOMATIZADO_ESTADO_INICIAL=PAUSED

# --- Login con Google (solo entran mails de este dominio) ---
AUTH_DOMINIO=prosumia.la
# 1 = cualquier mail del dominio entra solo (sin accesos hasta que un admin
# se los asigne en Panel Usuarios). 0 = solo entra quien un admin dio de alta.
AUTH_ALTA_LIBRE=1

# OAuth Client "web" de Google Cloud Console (APIs & Services → Credentials
# → Create OAuth Client ID → Web application). El Redirect URI tiene que
# estar cargado tal cual en ese Client (Authorized redirect URIs) — sumar
# ahí también la URL de producción cuando se despliega (ej. Railway).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Hoja "CodigosContenido" de AppSheet (planilla de carga de codigos, va a
# BigQuery). Los codigos nuevos siguen su secuencia y cada pedido creado se
# inserta ahi (no los TEST ni los de la ingesta). Vacio = solo Excel + cola_pautas.
CODIGOS_SHEET_ID=
CODIGOS_HOJA=CodigosContenido
PROYECTOS_ACTIVIDAD_DESDE=2026-08-15
# Clientes apagados por ahora (todos sus proyectos), separados por coma.
CLIENTES_OCULTOS=
# Desde que fecha (ISO) se muestra el Historial que sale de la hoja CodigosContenido.
HISTORIAL_DESDE=2026-09-01
# Clientes habilitados solo para el canal Informativo (Oficial apagado con leyenda).
CLIENTES_SOLO_INFORMATIVO=
# Ventana movil en dias: proyectos sin codigos en ese lapso no se ofrecen salvo que un admin los active.
PROYECTOS_INACTIVIDAD_DIAS=45

# --- Aviso diario por mail del presupuesto restante de las cuentas
# automatizadas (limite de gasto de la cuenta - gastado - asignado a pautas
# activas). Sale por Gmail API (HTTPS) si hay GMAIL_REFRESH_TOKEN — Railway
# bloquea SMTP saliente — o por SMTP_* si no. Sin ALERTAS_MAIL_TO no se
# manda nada.
# GMAIL_REFRESH_TOKEN se consigue UNA vez entrando a /auth/gmail con la
# casilla que manda (mismo cliente OAuth del login; registrar el Redirect
# URI /auth/gmail/callback en Google Cloud Console y habilitar Gmail API).
GMAIL_REFRESH_TOKEN=
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu@gmail.com,
# SMTP_PASS=contrasena de aplicacion (Cuenta Google -> Seguridad -> Verificacion
# en dos pasos -> Contrasenas de aplicaciones).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Destinatarios separados por coma.
ALERTAS_MAIL_TO=
# Hora (0-23, Argentina) a la que sale el resumen.
ALERTAS_HORA=9
